{
  "name": "@lobby/server",
  "version": "1.0.0",
  "private": true,
  "license": "MPL-2.0",
  "type": "module",
  "description": "Lobby Server: indexes a household's films and series and serves them to paired devices.",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "lobby": "./src/cli.ts"
  },
  "scripts": {
    "start": "node src/cli.ts serve",
    "dev": "node --watch src/cli.ts serve",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "bonjour-service": "^1.4.4",
    "hono": "^4.13.21",
    "multicast-dns": "^7.2.5"
  },
  "devDependencies": {
    "@types/multicast-dns": "^7.2.4"
  }
}
